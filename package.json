{
  "name": "taktyl",
  "private": true,
  "version": "0.0.0",
  "description": "Taktyl - fikcyjny sklep demonstracyjny (monorepo)",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
