# Taktyl - przykładowa konfiguracja. Skopiuj do .env i zastąp wszystkie CHANGE_ME.
# Ten plik zawiera WYŁĄCZNIE placeholdery. Nigdy nie wpisuj tu prawdziwych sekretów.

# --- Ogólne ---
NODE_ENV=production
COMPOSE_PROJECT_NAME=taktyl
TZ=Europe/Warsaw

# --- Baza (ADR-0005, ADR-0009) ---
POSTGRES_USER=taktyl
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=taktyl
DATABASE_URL=postgresql://taktyl:CHANGE_ME@db:5432/taktyl?schema=public
# Baza wylacznie dla testow integracyjnych (CZYSCI ja przy kazdym przebiegu; nigdy ta sama co DATABASE_URL)
TEST_DATABASE_URL=postgresql://taktyl:CHANGE_ME@db:5432/taktyl_test?schema=public

# --- API (NestJS) ---
API_PORT=4000
LOG_LEVEL=info
METRICS_ENABLED=false
# Limity zadan (@nestjs/throttler); false tylko w testach
RATE_LIMIT_ENABLED=true
# Dokumentacja OpenAPI pod /docs i /openapi.json: poza produkcja zawsze, w produkcji tylko gdy true
OPENAPI_ENABLED=false
API_CORS_ORIGINS=http://taktyl.localhost,http://admin.taktyl.localhost
# Długi losowy ciąg (min. 32 znaki)
SESSION_SECRET=CHANGE_ME
# I-008: puste SESSION_COOKIE_SECURE= bylo odrzucane przez API (enum true|false), wiec zostaje zakomentowane.
# Cookie sesji backpanelu (HttpOnly; SameSite=Strict). Secure domyslnie wlaczone w produkcji (NODE_ENV=production);
# false tylko w lokalnym dev/test bez HTTPS (API-008).
SESSION_COOKIE_DOMAIN=.taktyl.localhost
# SESSION_COOKIE_SECURE=false
# Sesja wygasa 12 h po logowaniu i po 30 min bezczynnosci (docs/18 D)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
# Limit nieudanych prob logowania (B-004): na konto w oknie, na adres IP szerzej (wspolne NAT)
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_WINDOW_MINUTES=15

# --- Backpanel: konto startowe (ADR-0006) ---
# Tworzone przy starcie tylko, gdy w bazie nie ma konta owner. Adres wyłącznie w domenie taktyl.example,
# hasło min. 12 znaków (placeholder CHANGE_ME przerywa start API). Puste = brak konta (ostrzeżenie w logu).
ADMIN_BOOTSTRAP_EMAIL=owner@taktyl.example
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME
# true = przycisk "Wejdź jako viewer", cykliczny reset danych demo
DEMO_MODE=false
DEMO_RESET_CRON=0 4 * * *
# Profil demo (reset-demo): odstep miedzy resetami w sekundach (I-003)
DEMO_RESET_INTERVAL_SECONDS=86400

# --- Propagacja zmian backpanel -> sklep (ADR-0003) ---
# Wspólny sekret HMAC dla webhooka /api/revalidate
REVALIDATE_SECRET=CHANGE_ME
REVALIDATE_URL=http://web:3000/api/revalidate
SHOP_REVALIDATE_SECONDS=300
# Worker outboxa (B-060): interwal sprawdzania kolejki, paczka wierszy, limit czasu wywolania webhooka
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_MS=2000
OUTBOX_BATCH_SIZE=100
REVALIDATE_TIMEOUT_MS=5000

# --- Kontrola treści panelu (reguła 5) ---
# Lista nazw prawdziwych marek (po przecinku), które walidatory panelu odrzucają w treściach i ustawieniach.
# Zostaw puste w repozytorium; wpisz lokalnie (plik .env nie trafia do repo).
FORBIDDEN_BRANDS=

# --- Zamówienia (ADR-0007) ---
ORDER_RETENTION_DAYS=30

# --- Formularze (docs/17 par. 9) ---
# Wiadomosci z kontaktu i zapisy newslettera sa usuwane po tylu dniach
MESSAGE_RETENTION_DAYS=30

# --- Sklep (Next.js) ---
WEB_PORT=3000
PUBLIC_SITE_URL=http://taktyl.localhost
PUBLIC_API_URL=http://api.taktyl.localhost
# Adres API w sieci Docker (renderowanie po stronie serwera)
INTERNAL_API_URL=http://api:4000

# --- Backpanel (Next.js) ---
ADMIN_PORT=3001
PUBLIC_ADMIN_URL=http://admin.taktyl.localhost

# --- Pomiar (docs/10): zostaw puste, aby nie ładować żadnego narzędzia ---
PUBLIC_GTM_ID=

# --- Seed (opcjonalnie) ---
# SEED_ROOT: katalog z data/, assets/, content/ (domyslnie wykrywany); SEED_NOW: stala data ISO dla powtarzalnej historii cen
# SEED_ROOT=
# SEED_NOW=

# --- Media (zdjęcia dostarczone przez człowieka, docs/09) ---
MEDIA_DIR=/data/media
MEDIA_PUBLIC_URL=http://taktyl.localhost/media

# --- Proxy (Caddy) ---
# Port HTTP na hoscie; gdy 80 jest zajety, ustaw np. 8080 i wchodz na http://taktyl.localhost:8080
PROXY_HTTP_PORT=80
# Lokalnie tylko HTTP (I-004); TLS dojdzie z hostingiem pod prawdziwa domena (Caddy robi to sam).
