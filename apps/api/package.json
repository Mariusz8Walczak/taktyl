{
  "name": "@taktyl/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS: REST API sklepu i backpanelu",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "prisma generate && tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset-demo": "tsx prisma/seed/index.ts --reset"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.16.0",
    "@taktyl/contracts": "workspace:*",
    "@taktyl/domain": "workspace:*",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.16.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1"
  }
}
