# I-004 (ADR-0009, docs/11 par. 1.1, TAKTYL-5): reverse proxy Taktyla.
# Wewnatrz kontenera Caddy slucha na 8080 (bez uprawnien roota); host mapuje PROXY_HTTP_PORT (domyslnie 80).
# Lokalnie tylko HTTP (*.localhost); TLS dojdzie przy hostingu pod prawdziwa domena (Caddy robi to sam).
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

# Wspolne dla KAZDEGO hosta i KAZDEJ odpowiedzi, takze bledow: noindex (regula 10) i naglowki bezpieczenstwa.
# "defer" ustawia naglowek po odpowiedzi z upstreamu, wiec nie da sie go nadpisac z aplikacji.
(wspolne) {
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
		defer
	}
}

# Odpowiedzi bledow generowane przez sam proxy (502, 503...) tez niosa naglowki wspolne.
(bledy) {
	handle_errors {
		header {
			X-Robots-Tag "noindex, nofollow"
			X-Content-Type-Options "nosniff"
			Cache-Control "no-store"
			defer
		}
		respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}
}

# Sklep + zdjecia z wolumenu media (docs/09).
http://taktyl.localhost:8080 {
	import wspolne
	import bledy

	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle {
		header /_next/static/* >Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}
}

# Backpanel.
http://admin.taktyl.localhost:8080 {
	import wspolne
	import bledy

	header /_next/static/* >Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy {$ADMIN_UPSTREAM:admin:3001}
}

# API.
http://api.taktyl.localhost:8080 {
	import wspolne
	import bledy

	reverse_proxy {$API_UPSTREAM:api:4000}
}

# Pozostale hosty (nieznany Host, adres IP) i healthcheck samego proxy.
http://:8080 {
	import wspolne
	import bledy

	respond /healthz "ok" 200
	respond "Nieznany host" 404
}
