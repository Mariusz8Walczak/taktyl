# syntax=docker/dockerfile:1.7
# I-003 (ADR-0009, TAKTYL-4): obraz narzedziowy calego monorepo (profile dev i test, lint, typecheck, testy).
# To NIE jest obraz produkcyjny: ma devDependencies i zrodla. Obrazy produkcyjne: apps/*/Dockerfile.
#   docker build -f infra/docker/Dockerfile.workspace .
ARG NODE_IMAGE=node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

FROM ${NODE_IMAGE} AS workspace
ENV PNPM_HOME=/pnpm \
    npm_config_store_dir=/pnpm/store \
    CI=true \
    NEXT_TELEMETRY_DISABLED=1
ENV PATH=$PNPM_HOME:$PATH
RUN apk add --no-cache openssl libc6-compat git \
 && corepack enable \
 && corepack prepare pnpm@12.10.1 --activate
WORKDIR /app
# Warstwa zalezy tylko od lockfile: pobranie paczek do magazynu (cache), potem instalacja offline.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN --mount=type=cache,target=/pnpm/store pnpm fetch
COPY . .
RUN --mount=type=cache,target=/pnpm/store pnpm install --frozen-lockfile --offline
CMD ["sh"]
